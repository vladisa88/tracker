# Copy to .env.backup, chmod 600; independent from the frontend/app environment.
# Dedicated PRIVATE bucket/prefix in an external provider, never this server.
BACKUP_BUCKET=
BACKUP_PREFIX=tracking/production/
# Leave empty for AWS; otherwise HTTPS S3-compatible endpoint.
BACKUP_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
